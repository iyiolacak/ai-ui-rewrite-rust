import { AssistantTheme } from "../theme.slint";

// The model and committed selection belong to the host. Indices are scoped to
// the model supplied at activation and must be revalidated by the host.
// Increment model-revision before any replacement, reorder, or content update,
// including mutations of a shared model. A revision must not be reused while a
// pointer gesture is in progress.
export component AssistantThreadSelector inherits Rectangle {
    in property <[string]> model;
    in property <int> model-revision: 0;
    in property <int> selected-index: -1;
    in property <bool> enabled: true;
    in property <string> placeholder: "Select a thread";
    callback selected(int);
    // The host searches its authoritative model from start-index, wrapping if
    // desired, and returns -1 when the query has no match or is not text.
    in property <bool> typeahead-enabled: false;
    callback find-prefix(string, int) -> int;

    private property <int> cursor: 0;
    private property <int> first: 0;
    private property <int> visible-count: min(6, root.model.length);
    // Trackpad wheels can report deltas smaller than one logical pixel.
    // Retain them until they add up to one row instead of dropping them.
    private property <length> wheel-remainder: 0px;
    private property <string> query: "";
    private property <bool> selectable: root.enabled && root.model.length > 0;
    private property <bool> popup-focused;
    out property <bool> has-focus: trigger-focus.has-focus || root.popup-focused;

    preferred-width: 180px;
    min-width: 80px;
    preferred-height: 36px;
    min-height: 36px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.has-focus && root.enabled ? AssistantTheme.focus-border : AssistantTheme.border;
    background: trigger-area.has-hover && root.selectable ? AssistantTheme.surface : AssistantTheme.composer;
    opacity: root.selectable ? 1 : 0.5;
    forward-focus: trigger-focus;

    function open-menu() {
        if root.selectable {
            root.cursor = root.selected-index >= 0 && root.selected-index < root.model.length ? root.selected-index : 0;
            root.first = max(0, min(root.cursor, root.model.length - root.visible-count));
            root.wheel-remainder = 0px;
            root.clear-query();
            popup.show();
        }
    }
    function move-cursor(index: int) {
        root.cursor = max(0, min(index, root.model.length - 1));
        if root.cursor < root.first { root.first = root.cursor; }
        if root.cursor >= root.first + root.visible-count { root.first = root.cursor - root.visible-count + 1; }
    }
    function choose(index: int) {
        if root.selectable && index >= 0 && index < root.model.length {
            root.clear-query();
            popup.close();
            trigger-focus.focus();
            root.selected(index);
        }
    }
    function clear-query() {
        root.query = "";
        query-timeout.running = false;
    }
    function search-input(input: string) -> bool {
        if !root.typeahead-enabled || input == "" || input.character-count > 32 { return false; }
        let candidate = root.query + input;
        let index = candidate.character-count <= 32
            ? root.find-prefix(candidate, root.query == "" ? root.cursor + 1 : root.cursor)
            : -1;
        if root.accept-match(candidate, index) { return true; }
        if root.query != "" {
            // A new character can begin a fresh search, or cycle items that
            // share the same initial. Never commit a host-provided invalid row.
            return root.accept-match(input, root.find-prefix(input, root.cursor + 1));
        }
        return false;
    }
    function accept-match(candidate: string, index: int) -> bool {
        if index < 0 || index >= root.model.length { return false; }
        root.query = candidate;
        query-timeout.running = false;
        query-timeout.running = true;
        root.wheel-remainder = 0px;
        root.move-cursor(index);
        return true;
    }
    query-timeout := Timer {
        interval: 800ms;
        running: false;
        triggered => { root.clear-query(); }
    }
    function wheel(delta: length) -> bool {
        if delta == 0px || !root.selectable { return false; }
        // Do not retain motion into the end of the list or prevent a parent
        // surface from handling a subsequent gesture at that boundary.
        if (delta < 0px && root.cursor == root.model.length - 1)
            || (delta > 0px && root.cursor == 0) {
            root.wheel-remainder = 0px;
            return false;
        }
        root.wheel-remainder -= delta;
        let steps = floor(abs(root.wheel-remainder) / 36px);
        if steps >= 1 {
            let direction = root.wheel-remainder > 0px ? 1 : -1;
            root.move-cursor(root.cursor + direction * steps);
            root.wheel-remainder -= direction * steps * 36px;
            if (direction > 0 && root.cursor == root.model.length - 1)
                || (direction < 0 && root.cursor == 0) {
                root.wheel-remainder = 0px;
            }
        }
        return true;
    }
    changed enabled => { if !root.enabled { root.clear-query(); popup.close(); } }
    // Keyboard navigation is also scoped to the model that was visible when
    // the popup opened. Require a fresh interaction after a model update.
    changed model-revision => { root.clear-query(); popup.close(); }
    changed model => {
        root.clear-query();
        if root.model.length == 0 { popup.close(); }
        else {
            root.first = max(0, min(root.first, root.model.length - root.visible-count));
            root.move-cursor(root.cursor);
        }
    }

    Text {
        x: 12px;
        width: max(0px, parent.width - 38px);
        text: root.selected-index >= 0 && root.selected-index < root.model.length ? root.model[root.selected-index] : root.placeholder;
        color: root.selected-index >= 0 && root.selected-index < root.model.length ? AssistantTheme.text : AssistantTheme.muted;
        font-family: "Inter";
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 24px;
        y: (parent.height - 14px) / 2;
        width: 14px; height: 14px;
        source: @image-url("../assets/chevron-down.svg");
        colorize: AssistantTheme.muted;
    }
    trigger-focus := FocusScope {
        enabled: root.selectable;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.open-menu();
                return accept;
            }
            return reject;
        }
        trigger-area := TouchArea {
            enabled: root.selectable;
            mouse-cursor: pointer;
            clicked => { trigger-focus.focus(); root.open-menu(); }
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.visible-count * 36px + 12px + (root.model.length > root.visible-count ? 48px : 0px);
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            changed has-focus => { root.popup-focused = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home
                    || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown {
                    root.wheel-remainder = 0px;
                    root.clear-query();
                }
                if event.text == Key.DownArrow { root.move-cursor(root.cursor + 1); return accept; }
                if event.text == Key.UpArrow { root.move-cursor(root.cursor - 1); return accept; }
                if event.text == Key.Home { root.move-cursor(0); return accept; }
                if event.text == Key.End { root.move-cursor(root.model.length - 1); return accept; }
                if event.text == Key.PageUp { root.move-cursor(root.cursor - root.visible-count); return accept; }
                if event.text == Key.PageDown { root.move-cursor(root.cursor + root.visible-count); return accept; }
                if event.text == Key.Return || event.text == Key.Space { root.choose(root.cursor); return accept; }
                if event.text == Key.Escape { root.clear-query(); popup.close(); trigger-focus.focus(); return accept; }
                if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                    && root.search-input(event.text) { return accept; }
                return reject;
            }
            Rectangle {
                border-radius: 8px;
                border-width: 1px;
                border-color: AssistantTheme.border;
                background: AssistantTheme.composer;
                VerticalLayout {
                    padding: 6px;
                    spacing: 0px;
                    if root.model.length > root.visible-count: Rectangle {
                        height: 24px;
                        Image { x: (parent.width - 14px) / 2; y: 5px; width: 14px; height: 14px; source: @image-url("../assets/chevron-up.svg"); colorize: root.first > 0 ? AssistantTheme.muted : AssistantTheme.disabled; }
                        TouchArea {
                            mouse-cursor: root.first > 0 ? pointer : default;
                            clicked => { if root.first > 0 { root.wheel-remainder = 0px; root.move-cursor(root.first - 1); } }
                            scroll-event(event) => { if root.wheel(event.delta-y) { return accept; } return reject; }
                        }
                    }
                    for row[index] in root.visible-count: Rectangle {
                        private property <int> pressed-index: -1;
                        private property <int> pressed-revision;
                        private property <string> pressed-label;
                        height: 36px;
                        border-radius: 6px;
                        background: row-area.has-hover || root.cursor == root.first + index ? AssistantTheme.surface : transparent;
                        Text {
                            x: 10px; width: max(0px, parent.width - 34px);
                            text: root.model[root.first + index];
                            font-family: "Inter"; font-size: 14px;
                            color: AssistantTheme.text; vertical-alignment: center; overflow: elide;
                        }
                        if root.selected-index == root.first + index: Image {
                            x: parent.width - 24px; y: 11px; width: 14px; height: 14px;
                            source: @image-url("../assets/check.svg"); colorize: AssistantTheme.text;
                        }
                        row-area := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    parent.pressed-index = root.first + index;
                                    parent.pressed-revision = root.model-revision;
                                    parent.pressed-label = root.model[parent.pressed-index];
                                }
                            }
                            clicked => {
                                // A recycled row or an updated host model must not
                                // turn the release into a different selection.
                                if parent.pressed-index == root.first + index
                                    && parent.pressed-index >= 0 && parent.pressed-index < root.model.length
                                    && parent.pressed-revision == root.model-revision
                                    && parent.pressed-label == root.model[parent.pressed-index] {
                                    root.choose(parent.pressed-index);
                                }
                                parent.pressed-index = -1;
                            }
                            scroll-event(event) => {
                                if root.wheel(event.delta-y) { return accept; }
                                return reject;
                            }
                        }
                    }
                    if root.model.length > root.visible-count: Rectangle {
                        height: 24px;
                        Image { x: (parent.width - 14px) / 2; y: 5px; width: 14px; height: 14px; source: @image-url("../assets/chevron-down.svg"); colorize: root.first + root.visible-count < root.model.length ? AssistantTheme.muted : AssistantTheme.disabled; }
                        TouchArea {
                            mouse-cursor: root.first + root.visible-count < root.model.length ? pointer : default;
                            clicked => { if root.first + root.visible-count < root.model.length { root.wheel-remainder = 0px; root.move-cursor(root.first + root.visible-count); } }
                            scroll-event(event) => { if root.wheel(event.delta-y) { return accept; } return reject; }
                        }
                    }
                }
            }
        }
    }
}
