import { ApprovalRequest, ApprovalChoice, ToolCopyTarget, ChatRow, ChatPartKind, MessageRole, MessageStatusTone, MessageFeedback } from "../models.slint";
import { AssistantTheme } from "../theme.slint";
import { AssistantEditComposer } from "edit-composer.slint";
import { AssistantPart } from "part.slint";
import { AssistantBranchPicker } from "branch-picker.slint";
import { AssistantIconButton } from "icon-button.slint";
import { AssistantFeedback } from "feedback.slint";
import { AssistantDraftAttachment } from "attachment-chip.slint";
import { AssistantHostEditorState } from "editor-host-state.slint";
import { AssistantEditorEdit, AssistantEditorClipboard } from "editor-surface.slint";

export component AssistantMessage inherits Rectangle {
    in property <ChatRow> message;
    in property <int> conversation-revision;
    callback toggle-part(string, string);
    callback page-requested(int, string, string, string, int, int);
    callback resolve-approval(ApprovalRequest, ApprovalChoice);
    in property <bool> busy;
    // The newest message; while `busy` it is the one being generated.
    in property <bool> last: false;
    callback switch-branch(string, bool);
    callback regenerate(string);
    in property <string> edit-token;
    // When supplied, this is the captured branch token and edit-token is a
    // fresh host-issued edit-session identity. Empty preserves older hosts.
    in property <string> edit-branch-token;
    in-out property <string> edit-draft;
    in property <bool> edit-attachments-enabled: false;
    in property <bool> can-add-edit-attachment: false;
    in property <bool> can-retry-edit-attachment: false;
    in property <bool> can-copy-edit-draft: false;
    in property <bool> edit-attachments-ready: true;
    in property <[AssistantDraftAttachment]> edit-attachments;
    // Presentation and operations belong to the host, not this recyclable row.
    in property <bool> host-edit-enabled: false;
    in property <AssistantHostEditorState> host-edit-state;
    callback host-edit-operation(string, AssistantEditorEdit, string, bool) -> bool;
    callback host-edit-place-caret(string, float, float);
    callback host-edit-begin-selection(string, float, float, bool) -> bool;
    callback host-edit-move-selection(string, float, float);
    callback host-edit-end-selection(string, float, float);
    callback host-edit-cancel-selection(string);
    callback host-edit-scroll(string, float) -> bool;
    callback host-edit-clipboard(string, AssistantEditorClipboard) -> bool;
    callback host-edit-save(string);
    callback host-edit-focus-changed(string, bool);
    callback host-edit-geometry-changed(string, float, float);
    callback host-edit-position-changed(string, float, float);
    callback begin-edit(string);
    callback save-edit(string, string);
    callback cancel-edit(string);
    callback remove-edit-attachment(string, string);
    callback add-edit-attachment(string);
    callback retry-edit-attachment(string, string);
    callback copy-edit-draft(string);
    private property <length> edit-height: 96px;
    private property <bool> editing: root.edit-token != "" && (root.edit-branch-token == "" ? root.edit-token : root.edit-branch-token) == root.message.branch-token;
    in property <bool> can-copy-code: false;
    in property <bool> can-copy-tool: false;
    callback copy-tool-requested(int, string, string, string, ToolCopyTarget);
    in property <bool> can-open-source: false;
    // The host must revalidate this scope and resolve the full source itself.
    callback source-requested(int, string, string, string);
    in property <bool> can-copy-message: false;
    callback copy-message(string);
    callback link-activated(string);
    callback copy-code(string);
    callback copy-code-block(string, string, string, string);
    callback submit-feedback(string, MessageFeedback);
    property <bool> user: root.message.role == MessageRole.user;
    // Upstream's default indicator mode ("no-text"): while the message runs and
    // has no parts yet or its last part is not text or reasoning (it ended on a
    // tool call). Streaming text is its own progress, and a pulse animating for
    // the whole stream also redrew the window at the display's refresh rate.
    property <ChatPartKind> last-kind: root.message.parts.length == 0 ? ChatPartKind.attachment : root.message.parts[root.message.parts.length - 1].kind;
    property <bool> working: root.busy && root.last && !root.user
        && (root.message.parts.length == 0 || (root.last-kind != ChatPartKind.text && root.last-kind != ChatPartKind.reasoning));
    height: (root.editing ? root.edit-height : bubble.height + (root.message.branch-count > 1 || root.message.can-regenerate || root.message.can-edit || root.message.can-copy || root.message.can-feedback ? 32px * AssistantTheme.hit-scale : 0px)) + 24px;
    // Pointer presence over the message body and the gaps. It sits behind the
    // content, but an enabled TouchArea above it (an action button, a link)
    // takes the pointer away from it, so the action row also reads each
    // button's own has-hover.
    hover := TouchArea {
        width: root.width;
        height: root.height;
    }
    sizing := Text {
        visible: false;
        // Only user bubbles use this width. Avoid measuring the entire
        // assistant response in a second, invisible Text: the software
        // renderer's 16-bit text-height calculation can overflow on long
        // multi-line responses before the visible Markdown is rendered.
        text: root.user ? root.message.width-hint : "";
        font-family: "Inter";
        font-size: 16px * AssistantTheme.text-scale;
    }
    if root.editing: editor := AssistantEditComposer {
        x: 8px; y: 0px;
        width: root.width - 16px;
        draft <=> root.edit-draft;
        retained-attachments: root.edit-attachments-enabled ? root.edit-attachments : root.message.retained-attachments;
        can-remove-attachments: root.edit-attachments-enabled;
        can-add-attachment: root.can-add-edit-attachment;
        can-retry-attachment: root.edit-attachments-enabled && root.can-retry-edit-attachment;
        can-copy-draft: root.can-copy-edit-draft;
        attachments-ready: root.edit-attachments-ready;
        host-editor-enabled: root.host-edit-enabled;
        host-editor-scope: root.edit-token;
        host-editor-state-scope: root.host-edit-state.scope;
        host-editor-state-token: root.host-edit-state.state-token;
        host-editor-frame-scope: root.host-edit-state.frame-scope;
        host-editor-frame-token: root.host-edit-state.frame-token;
        host-editor-frame: root.host-edit-state.frame;
        host-editor-frame-width: root.host-edit-state.frame-width;
        host-editor-frame-height: root.host-edit-state.frame-height;
        host-editor-preferred-height: root.host-edit-state.preferred-height;
        host-editor-empty: root.host-edit-state.empty;
        host-editor-pointer-selection-enabled: root.host-edit-state.pointer-selection-enabled;
        host-editor-allow-pending-selection: root.host-edit-state.allow-pending-selection;
        host-editor-can-submit: root.host-edit-state.can-submit;
        host-editor-focus-request: root.host-edit-state.focus-request;
        host-editor-geometry-request: root.host-edit-state.geometry-request;
        host-editor-edit(scope, operation, text, extend) => { return root.host-edit-operation(scope, operation, text, extend); }
        host-editor-place-caret(scope, x, y) => { root.host-edit-place-caret(scope, x, y); }
        host-editor-begin-selection(scope, x, y, extend) => { return root.host-edit-begin-selection(scope, x, y, extend); }
        host-editor-move-selection(scope, x, y) => { root.host-edit-move-selection(scope, x, y); }
        host-editor-end-selection(scope, x, y) => { root.host-edit-end-selection(scope, x, y); }
        host-editor-cancel-selection(scope) => { root.host-edit-cancel-selection(scope); }
        host-editor-scroll(scope, delta) => { return root.host-edit-scroll(scope, delta); }
        host-editor-clipboard(scope, kind) => { return root.host-edit-clipboard(scope, kind); }
        host-editor-save(scope) => { root.host-edit-save(scope); }
        host-editor-cancel(scope) => { root.cancel-edit(scope); }
        host-editor-copy-draft(scope) => { root.copy-edit-draft(scope); }
        host-editor-focus-changed(scope, focused) => { root.host-edit-focus-changed(scope, focused); }
        host-editor-geometry-changed(scope) => { root.host-edit-geometry-changed(scope, self.host-editor-width / 1px, self.host-editor-height / 1px); }
        host-editor-position-changed(scope) => { root.host-edit-position-changed(scope, self.host-editor-x / 1px, self.host-editor-y / 1px); }
        add-attachment => { root.add-edit-attachment(root.edit-token); }
        retry-attachment(id) => { root.retry-edit-attachment(root.edit-token, id); }
        copy-draft => { root.copy-edit-draft(root.edit-token); }
        remove-attachment(id) => { root.remove-edit-attachment(root.edit-token, id); }
        changed height => { root.edit-height = self.height; }
        save(text) => { root.save-edit(root.edit-token, text); }
        cancel => { root.cancel-edit(root.edit-token); }
    }
    bubble := Rectangle {
        visible: !root.editing;
        y: 0px;
        x: root.user ? root.width - self.width - 8px : 8px;
        width: root.user ? min(root.width - 80px, max(96px, max(sizing.preferred-width + 32px, contents.preferred-width + 32px))) : root.width - 16px;
        height: contents.preferred-height + (root.user ? 16px : 0px);
        background: root.user ? AssistantTheme.surface : transparent;
        border-radius: root.user ? 16px : 0px;
        contents := VerticalLayout {
            x: root.user ? 16px : 0px;
            y: root.user ? 8px : 0px;
            width: parent.width - (root.user ? 32px : 0px);
            spacing: 8px;
            for part in root.message.parts: AssistantPart {
                part: part;
                message-id: root.message.id;
                branch-token: root.message.branch-token;
                conversation-revision: root.conversation-revision;
                toggle => { root.toggle-part(root.message.id, part.id); }
                page-requested(revision, message-id, part-id, token, page-number, delta) => { root.page-requested(revision, message-id, part-id, token, page-number, delta); }
                resolve-approval(request, choice) => { root.resolve-approval(request, choice); }
                can-copy-code: root.can-copy-code;
                can-copy-tool: root.can-copy-tool;
                copy-tool-requested(revision, message, branch, part, target) => { root.copy-tool-requested(revision, message, branch, part, target); }
                can-open-source: root.can-open-source;
                source-requested-scoped(revision, message, branch, part-id) => { root.source-requested(revision, message, branch, part-id); }
                link-activated(link) => { root.link-activated(link); }
                copy-code(code) => { root.copy-code(code); }
                copy-code-block(part-id, token, code) => { root.copy-code-block(root.message.branch-token, part-id, token, code); }
            }
            // Upstream's working indicator: a pulsing dot after the content.
            if root.working: Text {
                text: "●";
                color: AssistantTheme.text;
                font-size: 14px * AssistantTheme.text-scale;
                opacity: 0.75 + 0.25 * cos(animation-tick() / 2s * 360deg);
                accessible-label: "Assistant is working";
            }
            if root.message.status != "": Text {
                text: root.message.status;
                color: root.message.status-tone == MessageStatusTone.error ? AssistantTheme.error : AssistantTheme.muted;
                font-size: 14px * AssistantTheme.text-scale;
                wrap: word-wrap;
            }
        }
    }
    // Upstream `ActionBarPrimitive` autohide="not-last": the newest message
    // keeps its actions, while others show them while the pointer is over the
    // message, a control in the row has keyboard focus, or the copied state is
    // showing. The row keeps its layout space when hidden, so nothing below moves.
    // Cells are 28 px pitch with 24 px visuals centered, so the drawn icons keep
    // upstream's 4 px spacing. Hit areas are 28 px wide and 32 px tall.
    // Hidden on the message being generated (upstream `hideWhenRunning`).
    if !root.editing && !(root.busy && root.last) && (root.message.branch-count > 1 || root.message.can-regenerate || root.message.can-edit || root.message.can-copy || root.message.can-feedback): Rectangle {
        private property <length> copy-width: root.message.can-copy ? 28px * AssistantTheme.hit-scale : 0px;
        private property <length> edit-width: root.message.can-edit ? 28px * AssistantTheme.hit-scale : 0px;
        private property <length> regenerate-width: root.message.can-regenerate ? 28px * AssistantTheme.hit-scale : 0px;
        private property <length> feedback-width: root.message.can-feedback ? 56px * AssistantTheme.hit-scale : 0px;
        // Upstream's row starts at 8 px; the 2 px cell margin moves it 6 px.
        x: root.user ? root.width - self.width - 6px : 6px;
        y: bubble.height;
        width: copy-width + branches.width + edit-width + regenerate-width + feedback-width;
        height: 32px * AssistantTheme.hit-scale;
        opacity: (root.last || hover.has-hover || copy_action.has-hover || branches.has-hover || edit_action.has-hover || regenerate_action.has-hover || feedback.has-hover || copy_action.has-focus || branches.has-focus || edit_action.has-focus || regenerate_action.has-focus || feedback.has-focus || root.message.copied) ? 1 : 0;
        animate opacity { duration: 120ms; }
        copy_action := AssistantIconButton {
            x: 0px;
            visible: root.message.can-copy;
            icon: root.message.copied ? @image-url("../assets/check.svg") : @image-url("../assets/copy.svg");
            label: root.message.copied ? "Message copied" : "Copy message";
            tooltip: root.message.copied ? "Copied" : "Copy message";
            control-size: 24px * AssistantTheme.hit-scale;
            icon-size: 14px * AssistantTheme.text-scale;
            hit-width: 28px * AssistantTheme.hit-scale;
            hit-height: 32px * AssistantTheme.hit-scale;
            bordered: false;
            enabled: root.can-copy-message;
            activated => { root.copy-message(root.message.branch-token); }
        }
        branches := AssistantBranchPicker {
            x: copy-width;
            branch-number: root.message.branch-number;
            branch-count: root.message.branch-count;
            running: root.busy;
            previous => { root.switch-branch(root.message.branch-token, false); }
            next => { root.switch-branch(root.message.branch-token, true); }
        }
        edit_action := AssistantIconButton {
            x: copy-width + branches.width;
            visible: root.message.can-edit;
            icon: @image-url("../assets/pencil.svg");
            label: "Edit message";
            tooltip: "Edit message";
            control-size: 24px * AssistantTheme.hit-scale;
            icon-size: 14px * AssistantTheme.text-scale;
            hit-width: 28px * AssistantTheme.hit-scale;
            hit-height: 32px * AssistantTheme.hit-scale;
            bordered: false;
            enabled: !root.busy && root.edit-token == "";
            activated => { root.begin-edit(root.message.branch-token); }
        }
        regenerate_action := AssistantIconButton {
            x: copy-width + branches.width + edit-width;
            visible: root.message.can-regenerate;
            icon: @image-url("../assets/rotate-ccw.svg");
            label: "Regenerate response";
            tooltip: "Regenerate";
            control-size: 24px * AssistantTheme.hit-scale;
            icon-size: 14px * AssistantTheme.text-scale;
            hit-width: 28px * AssistantTheme.hit-scale;
            hit-height: 32px * AssistantTheme.hit-scale;
            bordered: false;
            guard-repeat: true;
            enabled: !root.busy;
            activated => { root.regenerate(root.message.branch-token); }
        }
        feedback := AssistantFeedback {
            x: copy-width + branches.width + edit-width + regenerate-width;
            visible: root.message.can-feedback;
            feedback: root.message.feedback;
            enabled: !root.busy;
            submit(choice) => { root.submit-feedback(root.message.branch-token, choice); }
        }
    }
}
