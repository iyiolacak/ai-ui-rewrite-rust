import { AssistantTheme } from "../theme.slint";
import { ToolCopyTarget } from "../models.slint";
import { AssistantButton, AssistantButtonSize, AssistantButtonVariant } from "button.slint";

// Shared visual treatment for plain-text tool input and result values.
component ToolTextPanel inherits Rectangle {
    in property <string> value;
    in property <bool> can-copy: false;
    in property <int> conversation-revision;
    in property <string> message-id;
    in property <string> branch-token;
    in property <string> part-id;
    in property <ToolCopyTarget> target;
    callback copy-requested(int, string, string, string, ToolCopyTarget);
    background: AssistantTheme.surface.transparentize(0.5);
    border-radius: 8px;
    border-width: 1px;
    border-color: AssistantTheme.border;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.value;
            color: AssistantTheme.text.transparentize(0.1);
            font-family: AssistantTheme.mono-family;
            font-size: 12px * AssistantTheme.effective-text-scale;
            line-height-factor: 1.3;
            horizontal-stretch: 1;
            min-width: 0px;
            wrap: word-wrap;
        }
        if root.can-copy: VerticalLayout {
            AssistantButton {
                label: "Copy";
                accessible-name: root.target == ToolCopyTarget.arguments ? "Copy tool arguments" : "Copy tool result";
                size: AssistantButtonSize.small;
                variant: AssistantButtonVariant.ghost;
                enabled: root.message-id != "" && root.branch-token != "" && root.part-id != "";
                private property <int> captured-revision;
                private property <string> captured-message;
                private property <string> captured-branch;
                private property <string> captured-part;
                private property <ToolCopyTarget> captured-target;
                armed => {
                    self.captured-revision = root.conversation-revision;
                    self.captured-message = root.message-id;
                    self.captured-branch = root.branch-token;
                    self.captured-part = root.part-id;
                    self.captured-target = root.target;
                }
                activated => { root.copy-requested(self.captured-revision, self.captured-message, self.captured-branch, self.captured-part, self.captured-target); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// A presentation-only fallback for a host-projected tool call. Values are
// displayed as plain text; this component does not parse or execute them.
export component AssistantToolFallback inherits Rectangle {
    in property <bool> structured: false;
    in property <string> legacy-body;
    in property <string> arguments;
    in property <string> detail;
    in property <bool> has-result: false;
    in property <string> result-label: "Result";
    in property <string> result;
    // Capabilities and complete values belong to the host. These callbacks
    // carry only captured identities, never the possibly truncated preview.
    in property <bool> can-copy-arguments: false;
    in property <bool> can-copy-result: false;
    in property <int> conversation-revision;
    in property <string> message-id;
    in property <string> branch-token;
    in property <string> part-id;
    callback copy-requested(int, string, string, string, ToolCopyTarget);

    height: content.preferred-height;
    preferred-height: content.preferred-height;
    content := VerticalLayout {
        padding-left: 24px;
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 8px;
        if !root.structured && root.legacy-body != "": Text {
            text: root.legacy-body;
            color: AssistantTheme.muted;
            font-family: "Inter";
            font-size: 14px * AssistantTheme.effective-text-scale;
            wrap: word-wrap;
        }
        // The host capability can also represent a complete empty input.
        if root.structured && (root.arguments != "" || root.can-copy-arguments): ToolTextPanel {
            value: root.arguments;
            can-copy: root.can-copy-arguments;
            conversation-revision: root.conversation-revision;
            message-id: root.message-id;
            branch-token: root.branch-token;
            part-id: root.part-id;
            target: ToolCopyTarget.arguments;
            copy-requested(revision, message, branch, part, target) => { root.copy-requested(revision, message, branch, part, target); }
        }
        if root.structured && root.detail != "": Text {
            text: root.detail;
            color: AssistantTheme.muted;
            font-family: "Inter";
            font-size: 12px * AssistantTheme.effective-text-scale;
            wrap: word-wrap;
        }
        if root.structured && root.has-result: VerticalLayout {
            spacing: 4px;
            Text {
                text: (root.result-label == "" ? "Result" : root.result-label) + ":";
                color: AssistantTheme.muted;
                font-family: "Inter";
                font-size: 12px * AssistantTheme.effective-text-scale;
                font-weight: 500;
            }
            ToolTextPanel {
                value: root.result;
                can-copy: root.can-copy-result;
                conversation-revision: root.conversation-revision;
                message-id: root.message-id;
                branch-token: root.branch-token;
                part-id: root.part-id;
                target: ToolCopyTarget.result;
                copy-requested(revision, message, branch, part, target) => { root.copy-requested(revision, message, branch, part, target); }
            }
        }
    }
}
